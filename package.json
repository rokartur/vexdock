{
	"name": "vexdock",
	"version": "0.1.0-beta.99",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"workspaces": [
		"apps/*"
	],
	"type": "module",
	"scripts": {
		"auth": "cd apps/auth && bun run dev",
		"build": "cd apps/web && bun run build",
		"check": "vp check",
		"dev": "cd apps/web && bun run dev",
		"fix": "vp check --fix",
		"typecheck": "cd apps/web && bun run typecheck && cd ../auth && bun run typecheck"
	},
	"devDependencies": {
		"ultracite": "7.12.4",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"overrides": {
		"vite": "catalog:"
	},
	"catalog": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
		"vite-plus": "1.1.0"
	}
}
